{
  "name": "velorate",
  "private": true,
  "version": "0.0.0",
  "description": "Fast, flexible and production-ready rate limiting for modern applications.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.10.0",

  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",

    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",

    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "typecheck": "turbo run typecheck"
  },

  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "turbo": "^2.10.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}